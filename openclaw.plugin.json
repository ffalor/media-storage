{
  "id": "media-storage",
  "name": "Media Storage",
  "description": "Read-only storage analysis for Sonarr and Radarr libraries with a native Control UI page.",
  "version": "0.6.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sonarr": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "default": "http://localhost:8989/",
            "description": "Sonarr base URL."
          },
          "apiKey": {
            "description": "Sonarr API key as a SecretRef (for example a protected entry in Settings → Secrets).",
            "type": "object",
            "required": [
              "source",
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "env",
                  "file",
                  "exec",
                  "store"
                ]
              },
              "provider": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      },
      "radarr": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "default": "http://localhost:7878/",
            "description": "Radarr base URL."
          },
          "apiKey": {
            "description": "Radarr API key as a SecretRef (for example a protected entry in Settings → Secrets).",
            "type": "object",
            "required": [
              "source",
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "env",
                  "file",
                  "exec",
                  "store"
                ]
              },
              "provider": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      },
      "tautulli": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "default": "http://localhost:8181/",
            "description": "Tautulli base URL."
          },
          "apiKey": {
            "description": "Tautulli API key as a SecretRef (for example a protected entry in Settings → Secrets).",
            "type": "object",
            "required": [
              "source",
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "env",
                  "file",
                  "exec",
                  "store"
                ]
              },
              "provider": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      },
      "seerr": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "default": "http://localhost:5055/",
            "description": "Seerr base URL."
          },
          "apiKey": {
            "description": "Seerr API key as a SecretRef (for example a protected entry in Settings → Secrets).",
            "type": "object",
            "required": [
              "source",
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "env",
                  "file",
                  "exec",
                  "store"
                ]
              },
              "provider": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      }
    }
  },
  "uiHints": {
    "sonarr": {
      "label": "Sonarr",
      "help": "Connection to Sonarr (TV)."
    },
    "radarr": {
      "label": "Radarr",
      "help": "Connection to Radarr (movies)."
    },
    "tautulli": {
      "label": "Tautulli (optional)",
      "help": "Connection to Tautulli for watch stats. Leave the API key unset to hide watch stats."
    },
    "sonarr.url": {
      "label": "Sonarr URL",
      "help": "Address of your Sonarr server as seen from the Gateway, for example http://sonarr.local:8989/.",
      "placeholder": "http://localhost:8989/"
    },
    "sonarr.apiKey": {
      "label": "Sonarr API key secret",
      "help": "Which secret in Settings → Secrets holds the Sonarr API key. Set automatically to SONARR_API_KEY; to use a differently named secret, change only the \"id\" value. Find the key in Sonarr under Settings → General → Security."
    },
    "radarr.url": {
      "label": "Radarr URL",
      "help": "Address of your Radarr server as seen from the Gateway, for example http://radarr.local:7878/.",
      "placeholder": "http://localhost:7878/"
    },
    "radarr.apiKey": {
      "label": "Radarr API key secret",
      "help": "Which secret in Settings → Secrets holds the Radarr API key. Set automatically to RADARR_API_KEY; to use a differently named secret, change only the \"id\" value. Find the key in Radarr under Settings → General → Security."
    },
    "tautulli.url": {
      "label": "Tautulli URL",
      "help": "Address of your Tautulli server as seen from the Gateway, for example http://tautulli.local:8181/.",
      "placeholder": "http://localhost:8181/"
    },
    "tautulli.apiKey": {
      "label": "Tautulli API key secret",
      "help": "Which secret in Settings → Secrets holds the Tautulli API key. Set automatically to TAUTULLI_API_KEY; watch stats stay hidden until that secret exists. Find the key in Tautulli under Settings → Web Interface → API."
    },
    "seerr": {
      "label": "Seerr (optional)",
      "help": "Connection to Seerr (Overseerr/Jellyseerr) for who requested what."
    },
    "seerr.url": {
      "label": "Seerr URL",
      "help": "Address of your Seerr server as seen from the Gateway, for example http://seerr.local:5055/.",
      "placeholder": "http://localhost:5055/"
    },
    "seerr.apiKey": {
      "label": "Seerr API key secret",
      "help": "Which secret in Settings → Secrets holds the Seerr API key. Set automatically to SEERR_API_KEY; request info stays hidden until that secret exists. Find the key in Seerr under Settings → General → API Key."
    }
  },
  "activation": {
    "onStartup": true
  },
  "uiCapabilities": [
    "page",
    "navigation"
  ],
  "controlUi": {
    "entry": "dist/control-ui/981ec51a1309f94a3bbf23693b681a771e9e1fb1838b12bae236376bb3b4623e/index.js",
    "styles": [
      "dist/control-ui/981ec51a1309f94a3bbf23693b681a771e9e1fb1838b12bae236376bb3b4623e/index.css"
    ]
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "sonarr.apiKey",
          "expected": "string",
          "ownerKind": "capability"
        },
        {
          "path": "radarr.apiKey",
          "expected": "string",
          "ownerKind": "capability"
        },
        {
          "path": "tautulli.apiKey",
          "expected": "string",
          "ownerKind": "capability"
        },
        {
          "path": "seerr.apiKey",
          "expected": "string",
          "ownerKind": "capability"
        }
      ]
    }
  },
  "contracts": {
    "tools": []
  }
}

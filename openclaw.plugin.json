{
  "id": "media-storage",
  "name": "Media Storage",
  "description": "Read-only storage analysis for Sonarr and Radarr libraries with a native Control UI page.",
  "version": "0.3.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sonarr": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "default": "http://localhost:8989/",
            "description": "Sonarr base URL."
          },
          "apiKey": {
            "description": "Sonarr API key as a SecretRef (for example a protected entry in Settings → Secrets).",
            "type": "object",
            "required": [
              "source",
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "env",
                  "file",
                  "exec",
                  "store"
                ]
              },
              "provider": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      },
      "radarr": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "default": "http://localhost:7878/",
            "description": "Radarr base URL."
          },
          "apiKey": {
            "description": "Radarr API key as a SecretRef (for example a protected entry in Settings → Secrets).",
            "type": "object",
            "required": [
              "source",
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "env",
                  "file",
                  "exec",
                  "store"
                ]
              },
              "provider": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      }
    }
  },
  "uiHints": {
    "sonarr": {
      "label": "Sonarr",
      "help": "Connection to Sonarr (TV)."
    },
    "radarr": {
      "label": "Radarr",
      "help": "Connection to Radarr (movies)."
    },
    "sonarr.url": {
      "label": "Sonarr URL",
      "help": "Address of your Sonarr server as seen from the Gateway, for example http://sonarr.local:8989/.",
      "placeholder": "http://localhost:8989/"
    },
    "sonarr.apiKey": {
      "label": "Sonarr API key secret",
      "help": "Which secret in Settings → Secrets holds the Sonarr API key. Set automatically to SONARR_API_KEY; to use a differently named secret, change only the \"id\" value. Find the key in Sonarr under Settings → General → Security."
    },
    "radarr.url": {
      "label": "Radarr URL",
      "help": "Address of your Radarr server as seen from the Gateway, for example http://radarr.local:7878/.",
      "placeholder": "http://localhost:7878/"
    },
    "radarr.apiKey": {
      "label": "Radarr API key secret",
      "help": "Which secret in Settings → Secrets holds the Radarr API key. Set automatically to RADARR_API_KEY; to use a differently named secret, change only the \"id\" value. Find the key in Radarr under Settings → General → Security."
    }
  },
  "activation": {
    "onStartup": true
  },
  "uiCapabilities": [
    "page",
    "navigation"
  ],
  "controlUi": {
    "entry": "dist/control-ui/66d20c4aeb8e62f1fa56cb85f8af2ab64339fa81148c5a2ce47a2b864f8dccdc/index.js",
    "styles": [
      "dist/control-ui/66d20c4aeb8e62f1fa56cb85f8af2ab64339fa81148c5a2ce47a2b864f8dccdc/index.css"
    ]
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "sonarr.apiKey",
          "expected": "string",
          "ownerKind": "capability"
        },
        {
          "path": "radarr.apiKey",
          "expected": "string",
          "ownerKind": "capability"
        }
      ]
    }
  },
  "contracts": {
    "tools": []
  }
}
